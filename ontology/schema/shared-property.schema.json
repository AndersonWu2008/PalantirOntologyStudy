{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palantir-ontology-study.local/schema/shared-property.schema.json",
  "title": "Shared property",
  "description": "A property definition reusable across object types. Metadata is shared; property values are not.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rid", "apiName", "displayName", "status", "visibility", "baseType"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "common.schema.json#/$defs/resourceId" },
    "rid": { "$ref": "common.schema.json#/$defs/rid" },
    "apiName": { "$ref": "common.schema.json#/$defs/propertyApiName" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": { "$ref": "common.schema.json#/$defs/propertyStatus" },
    "visibility": { "$ref": "common.schema.json#/$defs/visibility" },
    "baseType": { "$ref": "common.schema.json#/$defs/baseType" },
    "valueType": { "type": "string" },
    "renderHints": { "$ref": "common.schema.json#/$defs/renderHints" },
    "typeClasses": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/typeClass" }
    },
    "valueFormatting": { "$ref": "common.schema.json#/$defs/valueFormatting" }
  }
}
